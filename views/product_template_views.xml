<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pos_bom" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.bom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Smart Button -->
            <div name="button_box" position="inside">
                <button name="action_view_pos_boms" type="object" class="oe_stat_button" icon="fa-list-alt" invisible="not is_pos_bom_product">
                    <field name="pos_bom_count" widget="statinfo" string="POS BoM"/>
                </button>
            </div>
            <!-- Add is_pos_bom_product checkbox in the top options area -->
            <div name="options" position="inside">
                <span class="d-inline-block">
                    <field name="is_pos_bom_product"/>
                    <label for="is_pos_bom_product" string="Is POS BoM Product"/>
                </span>
            </div>

        </field>
    </record>
</odoo>
